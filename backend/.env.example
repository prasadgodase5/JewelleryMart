# ----- Razorpay (UPI / payments) -----
# Sign up free at https://razorpay.com → Settings → API Keys → Generate Test Keys
# Test keys start with rzp_test_ and never charge real money.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET

# Optional: change backend port
PORT=3000
